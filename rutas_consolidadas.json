# ============================================================
# CELDA 4c — EDITOR DE TRAZADOS (mapa + pulsos + ida y vuelta + probar en Maps)
# Requiere: 4b y 5b corridas antes (orden: 4b → 5b → 4c)
# ============================================================
import webbrowser
import http.server, socketserver, threading, functools

EDITOR_PATH = BASE_DIR / "web" / "editor_rutas_nc.html"
SIMPLIF_EDITOR_M = 2      # simplifica solo para editar (69k -> ~10k vértices, sin cambio visible)

def a_lonlat(coords, idxs):
    return [coords[i] for i in idxs]

datos = []
for x in rev.sort_values(["score", "id"], ascending=[False, True]).itertuples():
    if not x.coords:
        continue
    keep = rdp_idx(a_metros(x.coords), SIMPLIF_EDITOR_M)
    datos.append({
        "id": x.id, "celula": x.celula, "origen": x.origen, "destino": x.destino,
        "calles": x.calles, "dist_ficha": x.distancia_ficha, "score": int(x.score),
        "alertas": x.alertas, "coords": [x.coords[i] for i in keep],
        "virajes": a_lonlat(x.coords, x.pts_vir), "alerta_pts": a_lonlat(x.coords, x.pts_alerta),
        "wps": waypoints_maps(x.coords),
        "vuelta_pts": [[lon, lat] for _, _, lon, lat in getattr(x, "ida_vuelta", [])],
        "alineacion": getattr(x, "alineacion", "") if getattr(x, "alineacion", "OK") != "OK" else "",
    })

HTML = r"""<!DOCTYPE html>
<html lang="es"><head><meta charset="utf-8"><title>Editor rutas NC</title>
<meta name="viewport" content="width=device-width, initial-scale=1">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@geoman-io/leaflet-geoman-free@2.17.0/dist/leaflet-geoman.css">
<style>
 body{margin:0;display:flex;height:100vh;font:13px system-ui,sans-serif}
 #side{width:340px;overflow:auto;padding:10px;box-sizing:border-box;border-right:1px solid #ccc;background:#fafafa}
 #map{flex:1}
 select,button{width:100%;margin:3px 0;padding:6px;font-size:13px}
 button{cursor:pointer;border:1px solid #bbb;border-radius:4px;background:#fff}
 button.on{background:#1d3557;color:#fff}
 .row{display:flex;gap:4px}.row button{flex:1}
 .al{color:#b00020;font-weight:600}.ok{color:#2a7a2a}
 ol{padding-left:20px;margin:4px 0}.muted{color:#777;font-size:12px}
 .kv b{display:inline-block;width:110px}
</style></head><body>
<div id="side">
 <select id="sel"></select>
 <div class="row"><button id="prev">◀ Anterior</button><button id="next">Siguiente ▶</button></div>
 <div id="info"></div>
 <hr>
 <button id="bEdit">✏️ Editar vértices</button>
 <button id="bCut">✂️ Cortar tramo (2 clics sobre la ruta)</button>
 <div class="row"><button id="bRev">⇄ Invertir sentido</button><button id="bReset">↺ Restaurar</button></div>
 <button id="bMaps">🗺️ Probar en Google Maps</button>
 <div class="row"><button id="bSave">💾 Descargar esta</button><button id="bAll">📦 Descargar editadas</button></div>
 <p class="muted">Editar: arrastra vértices, clic en el punto medio para agregar uno, clic derecho sobre un vértice para borrarlo.<br>
 Cortar: clic en el inicio y fin del tramo malo; se borran los vértices entre ambos y quedan unidos en línea recta (después ajustas con Editar).<br>
 🟣 ida y vuelta (Google hace loop) · 🔴 alertas (vuelta en U / tramo recto largo) · 🟠 virajes · ⚪🔵 pulsos de Google Maps · gris punteado = ruta pareja I/R.<br>
 ↩ en la lista = ruta con ida y vuelta.<br>
 Los cambios quedan guardados en este navegador hasta que los descargues.</p>
 <b>Calle a calle</b><ol id="calles"></ol>
</div>
<div id="map"></div>
<script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/@geoman-io/leaflet-geoman-free@2.17.0/dist/leaflet-geoman.min.js"></script>
<script>
const DATA = __DATA__;
const byId = Object.fromEntries(DATA.map(d => [d.id, d]));
const LS = "editor_rutas_nc_v1";
let edits = {}; try { edits = JSON.parse(localStorage.getItem(LS) || "{}"); } catch (e) {}
const persist = () => { try { localStorage.setItem(LS, JSON.stringify(edits)); } catch (e) {} };

const map = L.map("map").setView([-33.45, -70.65], 12);
const fondos = {
  "Calles (Esri)": L.tileLayer("https://server.arcgisonline.com/ArcGIS/rest/services/World_Street_Map/MapServer/tile/{z}/{y}/{x}",
                   {maxZoom: 19, attribution: "© Esri"}),
  "Satélite (Esri)": L.tileLayer("https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}",
                   {maxZoom: 19, attribution: "© Esri"}),
  "OpenStreetMap": L.tileLayer("https://tile.openstreetmap.org/{z}/{x}/{y}.png",
                   {maxZoom: 19, attribution: "© OpenStreetMap"}),
};
fondos["Calles (Esri)"].addTo(map);
L.control.layers(fondos).addTo(map);
const capa = L.layerGroup().addTo(map);
let linea = null, cur = null, editando = false, cortando = false, corteA = null;

const km = cs => { let s = 0; for (let i = 1; i < cs.length; i++) s += map.distance([cs[i-1][1], cs[i-1][0]], [cs[i][1], cs[i][0]]); return s / 1000; };
const coordsDe = id => edits[id] || byId[id].coords;
const ll = c => [c[1], c[0]];

function llenarSelect() {
  const sel = document.getElementById("sel"); const v = sel.value; sel.innerHTML = "";
  DATA.forEach(d => {
    const o = document.createElement("option"); o.value = d.id;
    o.textContent = `${edits[d.id] ? "✏️ " : ""}${d.vuelta_pts.length ? "↩ " : ""}${d.score >= 2 ? "⚠" + d.score + " " : ""}${d.id} · ${d.origen} → ${d.destino}`;
    sel.appendChild(o);
  });
  if (v) sel.value = v;
}

function pareja(id) { const p = id.slice(0, -1) + (id.endsWith("I") ? "R" : "I"); return byId[p] ? p : null; }

function info() {
  const d = byId[cur], cs = coordsDe(cur), dk = km(cs);
  const dif = d.dist_ficha ? ((dk / d.dist_ficha - 1) * 100) : null;
  document.getElementById("info").innerHTML = `
   <h3 style="margin:6px 0">${d.id} ${edits[cur] ? '<span class="ok">(editada)</span>' : ""}</h3>
   <div class="kv"><b>Célula</b>${d.celula}</div>
   <div class="kv"><b>Recorrido</b>${d.origen} → ${d.destino}</div>
   <div class="kv"><b>Dist. ficha</b>${d.dist_ficha ?? "—"} km</div>
   <div class="kv"><b>Dist. trazado</b>${dk.toFixed(2)} km ${dif === null ? "" : `<span class="${Math.abs(dif) > 20 ? "al" : "ok"}">(${dif > 0 ? "+" : ""}${dif.toFixed(0)}%)</span>`}</div>
   <div class="kv"><b>Vértices</b>${cs.length}</div>
   <div class="al">${d.alertas || ""}</div>
   ${d.alineacion ? `<div class="muted">Alineación: ${d.alineacion}</div>` : ""}`;
  document.getElementById("calles").innerHTML = d.calles.map(c => `<li>${c}</li>`).join("");
}

function dibujar(zoom) {
  capa.clearLayers(); const d = byId[cur], cs = coordsDe(cur);
  const p = pareja(cur);
  if (p) L.polyline(coordsDe(p).map(ll), {color: "#888", weight: 3, dashArray: "6 6", interactive: false}).addTo(capa);
  linea = L.polyline(cs.map(ll), {color: "#e63946", weight: 5}).addTo(capa);
  linea.on("pm:edit", () => { edits[cur] = linea.getLatLngs().map(p => [+p.lng.toFixed(6), +p.lat.toFixed(6)]); persist(); info(); llenarSelect(); });
  L.circleMarker(ll(cs[0]), {radius: 9, color: "#2a9d8f", fillOpacity: 1}).bindTooltip("Inicio: " + d.origen).addTo(capa);
  L.circleMarker(ll(cs[cs.length - 1]), {radius: 9, color: "#1d3557", fillOpacity: 1}).bindTooltip("Fin: " + d.destino).addTo(capa);
  if (!edits[cur]) {
    d.virajes.forEach(c => L.circleMarker(ll(c), {radius: 4, color: "#f4a261", fillOpacity: .9, interactive: false}).addTo(capa));
    d.alerta_pts.forEach(c => L.circleMarker(ll(c), {radius: 11, color: "#b00020", weight: 3, fillOpacity: .15})
      .bindTooltip("Revisar aquí").on("click", () => map.setView(ll(c), 17)).addTo(capa));
  }
  d.vuelta_pts.forEach(c => L.circleMarker(ll(c), {radius: 16, color: "#7b2cbf", weight: 4, fillOpacity: .15})
    .bindTooltip("Ida y vuelta: aquí Google hace loop").on("click", () => map.setView(ll(c), 17)).addTo(capa));
  d.wps.forEach((c, i) => L.circleMarker(ll(c), {radius: 6, color: "#1a73e8", fillColor: "#fff", fillOpacity: 1, weight: 3})
    .bindTooltip("Pulso Maps " + (i + 1)).addTo(capa));
  if (editando) linea.pm.enable({allowSelfIntersection: true});
  if (zoom) map.fitBounds(linea.getBounds(), {padding: [30, 30]});
  info();
}

function ir(id) { cur = id; document.getElementById("sel").value = id; setCorte(false); dibujar(true); }

function setEdit(on) {
  editando = on; document.getElementById("bEdit").classList.toggle("on", on);
  if (linea) on ? linea.pm.enable({allowSelfIntersection: true}) : linea.pm.disable();
}
function setCorte(on) {
  cortando = on; corteA = null; document.getElementById("bCut").classList.toggle("on", on);
  map.getContainer().style.cursor = on ? "crosshair" : "";
}
function masCercano(latlng) {
  const cs = coordsDe(cur); let best = 0, bd = Infinity;
  cs.forEach((c, i) => { const dd = map.distance(latlng, ll(c)); if (dd < bd) { bd = dd; best = i; } });
  return best;
}
map.on("click", e => {
  if (!cortando) return;
  const i = masCercano(e.latlng);
  if (corteA === null) { corteA = i; L.circleMarker(ll(coordsDe(cur)[i]), {radius: 8, color: "#000"}).addTo(capa); return; }
  let [a, b] = [corteA, i].sort((x, y) => x - y);
  const cs = coordsDe(cur).slice();
  if (b - a > 1) { cs.splice(a + 1, b - a - 1); edits[cur] = cs; persist(); llenarSelect(); }
  setCorte(false); dibujar(false);
});

function descargar(nombre, obj) {
  const a = document.createElement("a");
  a.href = URL.createObjectURL(new Blob([JSON.stringify(obj)], {type: "application/geo+json"}));
  a.download = nombre; a.click(); setTimeout(() => URL.revokeObjectURL(a.href), 1000);
}
const feature = id => ({type: "Feature", properties: {id, editado: new Date().toISOString()},
                        geometry: {type: "LineString", coordinates: coordsDe(id)}});

document.getElementById("sel").onchange = e => ir(e.target.value);
document.getElementById("prev").onclick = () => { const i = DATA.findIndex(d => d.id === cur); if (i > 0) ir(DATA[i - 1].id); };
document.getElementById("next").onclick = () => { const i = DATA.findIndex(d => d.id === cur); if (i < DATA.length - 1) ir(DATA[i + 1].id); };
document.getElementById("bEdit").onclick = () => { setCorte(false); setEdit(!editando); };
document.getElementById("bCut").onclick = () => { setEdit(false); setCorte(!cortando); };
document.getElementById("bRev").onclick = () => { edits[cur] = coordsDe(cur).slice().reverse(); persist(); llenarSelect(); dibujar(false); };
document.getElementById("bReset").onclick = () => { if (confirm("¿Descartar cambios de " + cur + "?")) { delete edits[cur]; persist(); llenarSelect(); dibujar(false); } };
document.getElementById("bSave").onclick = () => edits[cur] ? descargar(cur + ".geojson", feature(cur)) : alert("Esta ruta no tiene cambios.");
document.getElementById("bMaps").onclick = () => {
  const cs = coordsDe(cur), f = c => `${c[1]},${c[0]}`;
  if (edits[cur]) alert("Ruta editada: los pulsos son los del trazado original. Aplica la corrección (4d) y vuelve a correr 5b y 4c.");
  window.open("https://www.google.com/maps/dir/?api=1&travelmode=driving&origin=" + f(cs[0]) + "&destination=" + f(cs[cs.length - 1])
    + (byId[cur].wps.length ? "&waypoints=" + encodeURIComponent(byId[cur].wps.map(f).join("|")) : ""), "_blank");
};
document.getElementById("bAll").onclick = () => {
  const ids = Object.keys(edits); if (!ids.length) return alert("No hay rutas editadas.");
  descargar("correcciones_nc.geojson", {type: "FeatureCollection", features: ids.map(feature)});
};
llenarSelect(); ir(DATA[0].id);
</script></body></html>"""

EDITOR_PATH.write_text(HTML.replace("__DATA__", json.dumps(datos, ensure_ascii=False, separators=(",", ":"))), encoding="utf-8")
print(f"Editor -> {EDITOR_PATH} ({EDITOR_PATH.stat().st_size/1024:.0f} KB, {len(datos)} rutas)")

# --- servir por localhost (los mapas base bloquean archivos abiertos como file://) ---
class _Silencioso(http.server.SimpleHTTPRequestHandler):
    def log_message(self, *a):
        pass

PORT = 8765
if "servidor_editor" not in globals():
    socketserver.TCPServer.allow_reuse_address = True
    servidor_editor = socketserver.ThreadingTCPServer(
        ("127.0.0.1", PORT), functools.partial(_Silencioso, directory=str(EDITOR_PATH.parent)))
    threading.Thread(target=servidor_editor.serve_forever, daemon=True).start()

webbrowser.open(f"http://localhost:{PORT}/{EDITOR_PATH.name}")
